# Copy to .env for local use; never commit real credentials.
# The app does NOT automatically load .env. After editing it, load it in
# your shell before starting the app: set -a; source .env; set +a
# On Render, enter these keys and values in the service Environment settings.
# Do not override Render's PORT or RENDER_EXTERNAL_URL with example values.

# REQUIRED for the hosted dashboard (not the local `python -m jyoticve web`).
# Username must be nonempty and must not contain a colon.
JYOTICVE_ADMIN_USER=admin
# REQUIRED: enter a unique random password of at least 24 characters.
# Generate locally with: openssl rand -hex 24
# Left empty intentionally: there is no usable default password.
JYOTICVE_ADMIN_PASSWORD=
# REQUIRED: absolute path on persistent storage. On Render, attach a paid
# persistent disk at /var/data. Setting this variable does not create a disk.
JYOTICVE_DATA_DIR=/var/data/jyoticve

# PUBLIC ORIGIN: Render supplies RENDER_EXTERNAL_URL automatically.
# Outside Render, or for a custom domain, uncomment and replace this value.
# Use the public HTTPS origin with no path, query, or fragment.
# JYOTICVE_PUBLIC_ORIGIN=https://monitor.example.com

# OPTIONAL: NVD API key for higher request allowance; blank works without a key.
# Replace with your own key if available.
NVD_API_KEY=

# OPTIONAL: set only the destinations you enable in dashboard Settings.
# These are example variable names: each channel's url_env must match its key.
# Paste the full HTTPS webhook URL as the value, not just its token/API key.
# Slack example: https://hooks.slack.com/services/WORKSPACE/CHANNEL/TOKEN
SECURITY_SLACK_WEBHOOK=
# Teams: full HTTPS URL from your Adaptive Card workflow/webhook trigger.
SECURITY_TEAMS_WEBHOOK=
# Generic example: https://alerts.example.com/webhook/YOUR_TOKEN
SECURITY_WEBHOOK=

# OPTIONAL: unbuffered Python logs.
PYTHONUNBUFFERED=1
# Gunicorn defaults to port 10000 locally; Render supplies PORT automatically.
# PORT=10000

# PostgreSQL is NOT implemented in this version; storage uses SQLite and files.
# DATABASE_URL and PostgreSQL provider API keys are not currently read by the app.
# Future connection-string format (documentation only, not an active setting):
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
